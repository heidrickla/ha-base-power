__pycache__/
*.pyc
.venv/
venv/

# Tool caches. Each of these writes its own self-ignoring .gitignore, so they
# stay out of `git status` without this - but that is the tool's choice, not
# the repo's, and a tool that stops doing it would silently start offering 40
# files to the next `git add`.
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Base's application and anything derived straight from it. The repo holds the
# RECOVERED CONTRACT - proto/ and docs/ - never the app itself.
*.apk
apks/
bundle.hasm
hbc-parse.txt
strings.*.txt

# Credentials for tools/live_probe.py. `client` is the durable one, so a file
# holding it is as good as the account.
creds.txt
*session*.txt

# Agent instruction files and agent settings stay out of the published repo.
.claude/
AGENTS.md
CLAUDE.md
CONTRIBUTING.md
.cursorrules
